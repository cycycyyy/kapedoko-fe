{
  "name": "kapedoko-fe",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "build:mobile": "NUXT_PUBLIC_AUTH_STORAGE=local nuxt generate",
    "cap:sync": "bun run build:mobile && bunx cap sync",
    "cap:android": "bun run cap:sync && bunx cap open android",
    "cap:ios": "bun run cap:sync && bunx cap open ios",
    "cap:icons": "bun scripts/generate-app-icons.ts && bunx @capacitor/assets generate --ios --android --assetPath resources --iconBackgroundColor '#FAF8F5' --iconBackgroundColorDark '#FAF8F5'",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test": "bun test",
    "import:osm": "bun scripts/import-osm-cafes.ts",
    "import:amenities": "bun scripts/import-amenity-reports.ts",
    "export:places": "bun scripts/export-places-cafes.ts",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/preferences": "8.0.1",
    "@ionic/vue": "^8.8.19",
    "@ionic/vue-router": "^8.8.19",
    "@nuxt/image": "2.1.0",
    "@nuxtjs/ionic": "^1.0.2",
    "@nuxtjs/supabase": "^2.0.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ionicons": "^8.1.0",
    "leaflet": "1.9.4",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.5.2",
    "posthog-js": "^1.435.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/leaflet": "^1.9.22",
    "shadcn-nuxt": "^2.8.2",
    "shadcn-vue": "^2.8.2"
  }
}
