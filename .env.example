ENVIRONMENT=staging

####################################
# Production Environment Variables #
####################################

SUPABASE_URL=
SUPABASE_KEY=

NUXT_PUBLIC_R2_PUBLIC_BASE_URL=

POSTGRES_URL=

NUXT_PUBLIC_ANALYTICS_ENABLED=false
NUXT_PUBLIC_POSTHOG_KEY=
POSTHOG_PERSONAL_API_KEY=

#################################
# Staging Environment Variables #
#################################

STAGING_SUPABASE_URL=
STAGING_SUPABASE_KEY=

STAGING_NUXT_PUBLIC_R2_PUBLIC_BASE_URL=

STAGING_POSTGRES_URL=

STAGING_NUXT_PUBLIC_ANALYTICS_ENABLED=false
STAGING_NUXT_PUBLIC_POSTHOG_KEY=
STAGING_POSTHOG_PERSONAL_API_KEY=


# Optional zero-cost map tile override. Defaults to OSM standard tiles.
# NUXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
