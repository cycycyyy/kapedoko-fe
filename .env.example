NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-publishable-key

# In the Supabase dashboard, set Site URL to the web origin and add these
# Redirect URLs (plus the same paths on any Capacitor custom scheme you use):
#   http://localhost:3000/confirm
#   http://localhost:3000/reset-password
# Apply db/*.sql in filename order, including 20260928_favorites_profiles_moderation.sql.

# Optional zero-cost map tile override. Defaults to OSM standard tiles.
# NUXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NUXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Public base used to render approved cafe logos after R2 upload.
# Use the R2 public development URL (https://pub-xxxxx.r2.dev) or a custom domain.
# Do not use the S3 API host (https://<accountid>.r2.cloudflarestorage.com) — listings cannot load that.
# Enable public access on the bucket first: R2 → bucket → Settings → Public development URL.
# NUXT_PUBLIC_R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

# Set these on the Supabase Edge Function `presign-upload` (not the Nuxt client).
# Logos upload through the edge function, so R2 bucket CORS is not required.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=