NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-publishable-key

# In the Supabase dashboard, set Site URL to the web origin and add these
# Redirect URLs (plus the same paths on any Capacitor custom scheme you use):
#   http://localhost:3000/confirm
#   http://localhost:3000/reset-password
# Apply db/*.sql in filename order, including 20260929_admin_portal.sql,
# 20261002–20261006 amenity / audit files, and 20261008_admin_shop_csv_import.sql.
# Deploy Edge Functions in db/functions: presign-upload and admin-users.
# admin-users uses the project service role on the function, never in Nuxt.

# Optional zero-cost map tile override. Defaults to OSM standard tiles.
# NUXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NUXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Public base used to render approved cafe logos after R2 upload.
# Use the R2 public development URL (https://pub-xxxxx.r2.dev) or a custom domain.
# Do not use the S3 API host (https://<accountid>.r2.cloudflarestorage.com) — listings cannot load that.
# Enable public access on the bucket first: R2 → bucket → Settings → Public development URL.
# NUXT_PUBLIC_R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

# Optional: Amenity source-of-truth public view. Leave unset to use the view
# when it exists and fall back to review stats if the SQL is not applied yet.
# NUXT_PUBLIC_AMENITY_SOURCE_OF_TRUTH=true

# Product analytics (off unless enabled). Use a separate PostHog EU project for
# local/dev. Leave unset in production until consent UI is live.
# NUXT_PUBLIC_ANALYTICS_ENABLED=true
# NUXT_PUBLIC_POSTHOG_KEY=
# NUXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# NUXT_PUBLIC_APP_VERSION=1.0.0
# Staff-only personal API key (phx_…). Never prefix with NUXT_PUBLIC.
# POSTHOG_PERSONAL_API_KEY=

# Cafe catalog export uses gosom/google-maps-scraper (local binary or Docker):
#   bun run export:places -- --city=marikina
#   bun run export:places -- --cities=metro-manila,cebu-city,davao-city
# A Google Places API key is not required for that script.

# Set these on the Supabase Edge Function `presign-upload` (not the Nuxt client).
# Logos upload through the edge function, so R2 bucket CORS is not required.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=